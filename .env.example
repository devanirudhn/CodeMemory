# Backend: use a self-hosted Hindsight API or Hindsight Cloud.
HINDSIGHT_API_URL=
HINDSIGHT_API_KEY=

# Groq credentials stay on the backend; never prefix this with VITE_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional deployment settings.
FRONTEND_URL=
CODEMEMORY_TEAM_ID=demo-team
CODEMEMORY_DATA_DIR=.data
PORT=8080

# Frontend: leave VITE_API_BASE_URL empty for local Vite proxying.
# Set it to the deployed backend origin when deploying the static frontend.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
